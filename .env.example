# Host port the hub page is published on
LISTEN_PORT=8200

# Public domain the hub page links to; fills the __DOMAIN__ placeholder in
# index.html at container start (links become https://drivepod.<value> etc.)
SITE_DOMAIN=example.com

# WireGuard tunnel to the VPS reverse proxy (keys from `wg genkey`).
WG_PRIVATE_KEY=<wg genkey>
WG_ADDRESS=10.99.0.235/32
WG_PEER_PUBLIC_KEY=<server public key>
WG_PEER_ENDPOINT=<server-ip:port>
WG_PEER_PERSISTENT_KEEPALIVE=25
# This hub runs full-tunnel mode, which is why entrypoint.sh re-adds the docker
# bridge route in table 51820. Narrow it to <server-wg-ip>/32 if you do not want
# the LAN and every other container on the host pulled into the tunnel.
WG_PEER_ALLOWEDIPS=0.0.0.0/0
