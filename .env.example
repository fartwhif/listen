# Host port nginx is published on
LISTEN_PORT=8200
# Public domain the hub page links to (fills index.html's __DOMAIN__ placeholder)
SITE_DOMAIN=example.com
# WireGuard (mesh tunnel; same server as sibling services)
WG_PRIVATE_KEY=<wg genkey>
WG_PEER_PUBLIC_KEY=<server public key>
WG_PEER_ENDPOINT=<server-ip:port>
WG_ADDRESS=10.99.0.235/32
WG_PEER_ALLOWEDIPS=10.99.0.0/20
WG_PEER_PERSISTENT_KEEPALIVE=25
