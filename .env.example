# One file for the whole stack. Every name here is either read by the platform
# (entrypoint / gen-conf / hubauth / watchdog / vault-run / migrate) or passed
# through to a vendored app by platform/gen-conf.py's `passthrough()`. Defaults
# that matter are stated in comments; an unset credential leaves that service's
# own fallback in place, which is today's pre-hub behaviour.
#
# Convention: REAL values live only in this file (gitignored). Tracked files
# carry placeholders or env lookups, so a hostname change is a .env edit and a
# container recreate, never a rebuild.

# ---- where the state lives (host side) ------------------------------
# The single bind mount docker-compose.yml creates: $HUB_HOST_DIR is mounted at
# /mnt/stack and the state directory becomes $HUB_HOST_DIR/listen-data. One
# mount is not tidiness - os.link() works only inside a single mount, and the
# first-start import hardlinks the old media trees instead of duplicating 41 GB.
# Moving the data to another drive is therefore: stop the container, `mv` the
# listen-data directory, set HUB_HOST_DIR to its new parent, `up -d`. The
# filesystem must support hardlinks (ext4/xfs/btrfs) and must not be a network
# mount. Do NOT set HUB_DATA_DIR: compose's `environment:` outranks env_file, and
# the in-container path has to agree with the mount.
HUB_HOST_DIR=..

# ---- host ports (published by docker-compose.yml) -------------------
# 8200:80 is the gateway, i.e. every *.example.com proxy target inside the box.
LISTEN_PORT=8200
# Front broadcaster: must stay reachable from the mesh at this number, because
# the VPS proxy for frogrock.example.com and the URL registered with the Shoutcast
# directory both name it.
RADIO_PORT=8090
# stream-fix shim (the DNAS relay's pull target + the host-side check).
SHIM_PORT=8091
# Front GrabbyTube UI/API and the shared tuner pool.
GRABBY_PUBLIC_PORT=8101
TUNESTER_PORT=8102

# ---- WireGuard (the box's tunnel to the VPS) ------------------------
# Same peer as the six pre-hub containers used; this container takes over their
# WG identity, so the address is the one the VPS nginx server_names already
# point at. Get the key pair from `wg genkey | wg pubkey`; the VPS peer block in
# /etc/wireguard/wg0.conf must carry the pubkey this container derives.
WG_PRIVATE_KEY=
WG_ADDRESS=10.99.0.235/32
WG_PEER_PUBLIC_KEY=
WG_PEER_ENDPOINT=203.0.113.7:51820
# THE PART THAT BIT US BEFORE: this tunnel's route table is pinned (Table/FwMark
# in wireguard/wg0.conf.template), and everything locally connected is put back
# on eth0 by platform/entrypoint.sh. Listing the whole tunnel subnet is fine
# here (the mesh peers are reached through it), but a value that covered the
# docker bridges would divert sibling traffic into the tunnel.
WG_PEER_ALLOWEDIPS=10.99.0.0/20
WG_PEER_PERSISTENT_KEEPALIVE=25

# ---- public shape ---------------------------------------------------
# Fills the picker's links and the noVNC door URLs the exporter prints. No
# scheme, no trailing slash.
SITE_DOMAIN=listen.example.com
# Hub admin bootstrap: created once by `hub.py bootstrap`, then the DB owns the
# password. Set both on the first start only.
HUB_OWNER_USER=owner
HUB_OWNER_PASSWORD=
# Anonymous broadcast access (?pass= on the stream path only), judged by hubauth
# against X-Gate-Uri so it cannot be used on an API route. Generate:
#   openssl rand -base64 18
HUB_RADIO_PASS=

# ---- the concurrency gate (platform/ytdlgated) ----------------------
# One bucket for every yt-dlp in the box (two harvesters per partition, the
# tuner's searches, the tuner's archive-of-the-internet rips), because they all
# hammer the SAME Google session. Harvests queue on a file lock instead.
MAX_CONCURRENT_YTDLP=2

# ---- cookie vaults --------------------------------------------------
# One chromium per VAULT (Google account), started on demand. These are the
# account the vaults sign in as: partitions share an account by pointing at it
# with `"vault": "<id>"` in /data/partitions.json. A SECOND account needs
# GOOGLE_EMAIL/GOOGLE_PASSWORD in that vault host partition's `settings`, which
# win over the values below (README "Everything comes from the registry").
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# VNC door password (the second lock; the first is the hub session).
VNC_PASSWORD=
VNC_RESOLUTION=1280x800
# Watchdog lifecycle (platform/watchdog.py + vault-run.py): start chromium when
# a partition's cookies.txt is older than this, stop the family after this much
# idle, and give up after this many failed sign-in attempts per session-death.
HUB_VAULT_MAX_AGE=1800
HUB_VAULT_IDLE=120
HUB_VAULT_GRACE=180
HUB_VAULT_SCAN=30
HUB_VAULT_RETRY=300
HUB_VAULT_RETRY_MAX=3
HUB_VAULT_MAX_RUN=3600
# Sign-in attempt fuzzing and the session-death notifier.
AUTO_SIGNIN_DELAY_MIN=4
AUTO_SIGNIN_DELAY_MAX=25
NTFY_TOPIC=

# ---- pre-hub state import (platform/migrate.py, one-shot) -----------
# docker-compose.yml already points these at the sibling repos INSIDE the
# /mnt/stack mount, which is the only shape where the media import is a hardlink
# (same mount) rather than a copy (EXDEV fallback). They are listed here because
# they are the one part of the deploy a .env edit can get wrong silently: point a
# root at a tree outside the mount - another drive, the NAS - and the import
# still works, but copies. Uncomment to override (e.g. an archived tree), or to
# skip an import by naming a directory that does not exist. Delete
# <state dir>/.migrated to re-run; re-running is idempotent and never deletes
# anything from a source.
#HUB_LEGACY_DRIVEPOD_CACHE=/mnt/stack/DrivePod/cache
#HUB_LEGACY_GRABBY=/mnt/stack/GrabbyTube
#HUB_LEGACY_TUNESTER_DOWNLOADS=/mnt/stack/tunester/downloads
#HUB_LEGACY_YTCOOKIES_DATA=/mnt/stack/ytcookies/data

# ---- tuner pool sources (vendored tunester, one instance for all) --
# Usenet first, then NZB indices, then archive.org. Unset NNTP keys = the
# NNTP source is skipped; no API key = no NZB search.
TUNESTER_NNTP_HOST=news.example.com
TUNESTER_NNTP_PORT=563
TUNESTER_NNTP_USER=
TUNESTER_NNTP_PASS=
TUNESTER_NZB_APIKEY=
TUNESTER_NZB_API=https://api.nzb.life/v2
TUNESTER_NZB_I=
TUNESTER_NZB_ARTIST_PAGES=2
TUNESTER_NZB_COMP_CHECKS=2
TUNESTER_NZB_MAX_ARCHIVE_MB=1200
# AcoustID content gate: the studio-rip proof. Unset key = the gate is skipped
# (verdicts come from MusicBrainz + duration + the LLM only).
TUNESTER_ACOUSTID_KEY=
# Fraction, not percent: 0.7 = 70 % match confidence required for a fingerprint
# verdict to count. See stack/tunester/AGENTS.md before loosening it.
TUNESTER_ACOUSTID_MIN_CONF=0.7
# 1 (the default): a target-length rip with ZERO AcoustID coverage is a fixup,
# not a delivery. 0 downgrades that outcome to a warning.
TUNESTER_ACOUSTID_REQUIRE=1
# Verdict LLM: primary endpoint, then the OPENAI_* fallback.
TUNESTER_LLM_PRIMARY_BASE_URL=https://llm.example.com/v1
TUNESTER_LLM_PRIMARY_API_KEY=
TUNESTER_LLM_PRIMARY_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Answer store (stack/tunester/lookups.py): the pool caches what it ASKED for,
# not just what it downloaded — MusicBrainz / AcoustID / archive.org item
# metadata (72 h), catalog listings from nzb.life / archive.org / yt-dlp (60 min)
# and model verdicts, keyed by endpoint + model + prompt (168 h). 0 turns that
# class's store off, so every call goes to the live service again; a re-tune of a
# song a batch already asked about then re-pays the API latency and the rate
# budget. These cap the shared tuner's answer cache for the whole box.
#TUNESTER_LOOKUP_TTL_HOURS=72
#TUNESTER_SEARCH_TTL_MINUTES=60
#TUNESTER_LLM_TTL_HOURS=168

# ---- library dedup LLM (vendored GrabbyTube) ------------------------
# Empty/absent: duplicate detection falls back to its title/length heuristics.
GRABBY_LLM_API_KEY=
GRABBY_LLM_BASE_URL=
# Served model id (default qwen3.6-27b). A deployment whose endpoint serves
# something else must set this, or every request names an id the server only
# honours by aliasing.
GRABBY_LLM_MODEL=
# Shared secret for GrabbyTube's destructive endpoints (DrivePod's delete, the
# UI's clear-tuned). BOTH sides read the same value; empty disables the check.
GRABBY_API_TOKEN=
# Concurrency and audio shape have platform defaults (concurrency comes from the
# partition's `quota` in partitions.json), so these are overrides only.
# GRABBY_MAX_CONCURRENT=2
# GRABBY_AUDIO_BITRATE=160k

# ---- broadcaster (vendored FrogRock) --------------------------------
# Station identity in the Shoutcast directory listing and the player card.
SHOUTCAST_STATION_NAME=
SHOUTCAST_QUERY=
# Silence padding that absorbs the DNAS relay's reconnect gap at a track flip;
# only tune after reading FrogRock/SHOUTCAST.md.
# SILENCE_PREFIX_SEC=18

# ---- DrivePod -------------------------------------------------------
# Nothing to put here: DrivePod's Google access is the OAuth/cookie state in its
# own database (imported by migrate.py), and its paths, port, grabby URL, bgutil
# URL and yt-dlp gate all come from gen-conf's tenant env.

# ---- misc -----------------------------------------------------------
# supervisor socket (watchdog), registry path, generated-config path: defaults
# are already right inside the container; override only for a shell inside it.
# HUB_SUP_SOCK=/var/run/supervisor.sock
# HUB_REGISTRY=/data/partitions.json
# Debug: answers the gate's 401s with a reason header. Never enable on a box
# reachable by someone who is not you.
# HUB_AUTH_DEBUG=1
